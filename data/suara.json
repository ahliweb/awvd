      "syaratPakai": [
        "wajib menyatakan konten sebagai suara sintetis (butir e)",
        "dilarang untuk nasihat atau interpretasi medis (butir l)",
        "dilarang menirukan orang tanpa izin (butir g)",
        "pembatasan ini ikut bila bobot didistribusikan ulang"
      ],
      "larangMedis": true,
      "daring": false,
      "deterministik": false,
